{
  "$schema": "../schemas/brief.schema.json",
  "id": "pilot-v2-pq-unrolled-plaster-tower",
  "name": "Pilot Brief v2 — 1x1x2m Compression-Only PQ Tubular Plaster Tower (Min 2x2x2 Voxel, Unrolled Patterns)",
  "version": "2.0.0",
  "description": "Populated from the Pilot Brief (1x1m plan, 2m height, <=4 ground anchors, standard cast gypsum plaster, self-weight + 50 kg vertical load, L/300 deflection) plus minimum 2x2x2 voxel resolution, compression-only network, tube topology with >=1 longitudinal subdivision + PQ planarization pass per bar, per-bar unrolled fabrication patterns, and multi-objective minimization of total unrolled surface area and element count.",
  "envelope": {
    "units": "meters",
    "coordinateSystem": "Z-up",
    "maxPlanX": 1.0,
    "maxPlanY": 1.0,
    "targetHeightZ": 2.0,
    "minHeightZ": 1.90,
    "maxHeightZ": 2.05,
    "planTolerance": 0.02,
    "groundZ": 0.0,
    "groundTolerance": 0.02
  },
  "topology": {
    "minGridResolution": [2, 2, 2],
    "maxGridResolution": [4, 4, 6],
    "symmetryXY": true,
    "requireSingleConnectedComponent": true,
    "pruneNonAnchorLeaves": true,
    "note": "Minimum voxel resolution must be at least 2x2x2 (1x1x* grids are disallowed in this brief)."
  },
  "geometry": {
    "requireTubeTopology": true,
    "minLongitudinalSubdivLevels": 1,
    "requirePQOptimization": true,
    "maxQuadPlanarityErrorM": 0.0005,
    "requireWatertightManifoldMesh": true,
    "note": "Every bar must be a watertight quad-dominant tube topology with {longitudinal subdivision + PQ planarization} applied at least once."
  },
  "funicular": {
    "mode": "compression",
    "allowedModes": ["compression"],
    "requireCompressionOnly": true,
    "minCompressionDominance": 1.0,
    "maxTensileAxialForceN": 0.0,
    "maxEquilibriumResidualNorm": 1e-4,
    "note": "Network must be strictly compression-only (100% of bars in net axial compression under governing load case)."
  },
  "supports": {
    "minAnchors": 3,
    "maxAnchors": 4,
    "mustBeOnGround": true,
    "restraintType": "pinned",
    "note": "Maximum 4 pinned anchor points on the ground plane z = 0."
  },
  "material": {
    "name": "Standard Cast Gypsum Plaster (Plaster of Paris / Hydrocal)",
    "densityKgM3": 1250,
    "youngsModulusPa": 5.0e9,
    "poissonsRatio": 0.24,
    "compressiveStrengthPa": 12.0e6,
    "tensileStrengthPa": 2.0e6,
    "shearStrengthPa": 1.5e6
  },
  "loadCases": [
    {
      "id": "LC1_self_weight",
      "name": "Self-Weight Only",
      "required": true,
      "gravityMS2": 9.81,
      "distributedVerticalMassKg": 0,
      "distribution": "none"
    },
    {
      "id": "LC2_self_weight_plus_50kg",
      "name": "Self-Weight + 50 kg Vertical Distributed Load",
      "required": true,
      "idealTarget": true,
      "gravityMS2": 9.81,
      "distributedVerticalMassKg": 50.0,
      "distribution": "top_zone_nodes",
      "topZoneFractionZ": 0.85
    }
  ],
  "fabrication": {
    "requireUnrolledPatternsPerBar": true,
    "unrollFormat": "svg",
    "allowUnrollSelfIntersection": false,
    "minMemberLengthM": 0.04,
    "maxSlendernessRatio": 120,
    "minTubeOuterRadiusM": 0.012,
    "maxTubeOuterRadiusM": 0.090,
    "minWallThicknessM": 0.006,
    "note": "Each bar must produce a valid 2D unrolled fabrication pattern (planar quad strips) with total unrolled surface area minimized."
  },
  "acceptanceCriteria": {
    "maxDeflectionRatio": 0.0033333333,
    "characteristicLengthDef": "min(planSpan, height)",
    "maxDeflectionMeters": 0.0033333333,
    "maxDeflectionHeightRatioMeters": 0.0066666667,
    "minTensileSafetyFactor": 1.5,
    "minCompressiveSafetyFactor": 2.0,
    "minBucklingSafetyFactor": 2.0,
    "requireSingleConnectedComponent": true,
    "requireWatertightManifoldMesh": true,
    "minMemberLengthM": 0.04,
    "maxSlendernessRatio": 120,
    "minTubeOuterRadiusM": 0.012,
    "maxTubeOuterRadiusM": 0.090,
    "minWallThicknessM": 0.006
  },
  "objectives": [
    { "metric": "totalUnrolledSurfaceAreaM2", "direction": "minimize", "priority": 1, "note": "Minimize total unrolled 2D fabrication surface area across all bars." },
    { "metric": "elementCount", "direction": "minimize", "priority": 2, "note": "Minimize total number of structural bar elements (nEdges)." },
    { "metric": "centerlineMassKg", "direction": "minimize", "priority": 3, "note": "Minimize total cast plaster mass." },
    { "metric": "funicularEfficiency", "direction": "maximize", "priority": 4, "note": "Maximize pure axial compression efficiency." }
  ],
  "deliverables": {
    "htmlExplainer": {
      "required": true,
      "outputPath": "TOPOGEN_FDM_Foundry/foundry_report.html",
      "goldilocksLayers": ["H1_Use", "H2_Guide", "H3_Telemetry"],
      "requireZeroConsoleErrors": true
    },
    "videoShowcase60s": {
      "required": true,
      "outputPath": "TOPOGEN_FDM_Foundry/foundry_showcase_60s.mp4",
      "durationSeconds": 60,
      "fps": 30,
      "resolution": [1920, 1080],
      "minExploredOptionsCycled": 16,
      "requireAdjacentFEAInExploration": true,
      "requireUnifiedCADMeshDisplay": true,
      "requireFullTileCycle": true,
      "requirePostEncodeDecodeVerify": true
    }
  }
}
